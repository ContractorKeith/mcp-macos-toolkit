# Use absolute, colon-separated paths. If unset, the launch directory is used.
MCP_MACOS_ALLOWED_ROOTS=/Users/you/Projects:/Users/you/Documents/AgentNotes

# Optional local MLX semantic-search environment. Leave unset when unused.
# MCP_MACOS_MLX_PYTHON=/Users/you/.venvs/mcp-mlx/bin/python
# MCP_MACOS_MLX_EMBED_MODEL=mlx-community/all-MiniLM-L6-v2-4bit

# Mutation capabilities are deliberately absent. See docs/permissions.md.
